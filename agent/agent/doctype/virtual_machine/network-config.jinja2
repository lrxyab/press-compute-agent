network:
  version: 2
  ethernets:
    public:
      match:
        macaddress: {{ public_mac_address }}
      dhcp4: false
      addresses:
        - {{ ip_address }}/32
      routes:
        - to: 0.0.0.0/0
          via: {{ gateway }}
          on-link: true
      nameservers:
        addresses:
          - 8.8.8.8
          - 4.4.4.4
    private:
      match:
        macaddress: {{ private_mac_address }}
      dhcp4: true
      dhcp4-overrides:
          use-routes: false

network:
  version: 2
  ethernets:
    eth0:
      match:
        macaddress: {{ public_mac_address }}
      set-name: eth0
      dhcp4: false
      addresses:
        - {{ ip_address }}/32
      routes:
        - to: 0.0.0.0/0
          via: {{ gateway }}
          on-link: true
      nameservers:
        addresses:
          - 8.8.8.8
          - 4.4.4.4
    eth1:
      match:
        macaddress: {{ private_mac_address }}
      set-name: eth1
      dhcp4: true
